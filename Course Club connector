#include <iostream>
#include <vector>
#include <string>
using namespace std;

class Course { //courses
public:
    string name;
    vector<string> tags; //to find things
};

class Club { //clubs
public:
    string name;
    vector<string> tags; //to find things
};

bool isRelevant(Course course, Club club) {
    for (string courseTag : course.tags) {
        for (string clubTag : club.tags) {
            if (courseTag == clubTag) {
                return true;
            }
        }
    }
    return false;
}


int main() {
    // listed courses
    vector<Course> courses = {
        {"Criminal Law", {"law", "justice"}},
        {"Acting 1", {"theater", "performance"}},
        {"Computer Science", {"technology", "programming"}},
        {"Forensic Linguistics", {"language", "society"}}
    };

    // listed clubs
    vector<Club> clubs = {
        {"Model UN", {"law", "debate"}},
        {"Theatrical Players", {"theater", "acting"}},
        {"Coding Club", {"technology", "programming"}},
        {"Anthropology Club", {"culture", "language"}}
    };
    
    
//Display
    cout << "Select a course:\n";
    for (int i = 0; i < courses.size(); i++) {
        cout << i + 1 << ". " << courses[i].name << endl;
    }

//user
    int choice;
    cout << "Enter number: ";
    cin >> choice;

//check
    if (choice < 1 || choice > courses.size()) {
        cout << "Invalid choice.\n";
        return 0;
    }

Course selectedCourse = courses[choice - 1];

//results
    cout << "\nRelevant clubs for " << selectedCourse.name << ":\n";

    bool found = false;

    for (Club club : clubs) {
        if (isRelevant(selectedCourse, club)) {
            cout << "- " << club.name << endl;
            found = true;
        }
    }

    if (!found) {
        cout << "No matching clubs found.\n";
    }
   
return 0;
}
